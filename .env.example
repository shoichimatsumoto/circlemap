# 本番URL（SEO・sitemap用。独自ドメイン取得後に変更）
NEXT_PUBLIC_SITE_URL=https://circlemap-five.vercel.app

# 柱B: 同人ログ（関連記事バナー用）
NEXT_PUBLIC_DOUJIN_LOG_URL=https://doujin-log.vercel.app

# DMM Webサービス API
# https://affiliate.dmm.com/api/ で取得
DMM_API_ID=your_api_id
# API呼び出し用（990〜997番台）— 購入リンクの af_id にもこの ID を使う
DMM_AFFILIATE_ID=your_affiliate_id-990
# サイト登録ID（005等）— 管理画面のリンクツール用。API購入リンクには使わない
DMM_LINK_AFFILIATE_ID=your_affiliate_id-005

# Supabase（Step 3 で設定）
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# 同期バッチ用（サーバー側のみ・GitHubに上げない）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# 同期API保護用（英数字のみ推奨・URLにそのまま載せられる）
# 本番 Vercel も同じ値にすること → docs/同期ブックマーク.md 参照
SYNC_SECRET=cmSync235285
# Vercel Cron 用（SYNC_SECRET と同じ値で OK）
CRON_SECRET=cmSync235285
